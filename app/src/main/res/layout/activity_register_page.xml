<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forest_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:paddingTop="52dp"
        android:paddingBottom="48dp">

        <!-- Back button -->
        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/brass_light"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  BACK"
                android:textColor="@color/brass_light"
                android:textSize="9sp"
                android:letterSpacing="0.25"
                android:fontFamily="serif"/>
        </LinearLayout>

        <!-- Top label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NATIONAL HISTORICAL COMMISSION OF THE PHILIPPINES"
            android:textColor="@color/brass"
            android:gravity="center"
            android:textSize="9sp"
            android:letterSpacing="0.25"
            android:fontFamily="serif"
            android:layout_marginBottom="24dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="@color/ivory"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register to access the archive"
            android:textColor="@color/brass_light"
            android:textSize="16sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:layout_marginBottom="32dp"/>

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="36dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_brass"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  ◆  "
                android:textColor="@color/brass"
                android:textSize="12sp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_brass"/>
        </LinearLayout>

        <!-- NAME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FULL NAME"
            android:textColor="@color/brass"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:fontFamily="serif"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your full name"
            android:inputType="textPersonName"
            android:textColor="@color/ivory"
            android:textColorHint="@color/text_moss"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="20dp"/>

        <!-- DATE OF BIRTH -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATE OF BIRTH"
            android:textColor="@color/brass"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:fontFamily="serif"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/dob"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Select your birth date"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:textColor="@color/ivory"
            android:textColorHint="@color/text_moss"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="20dp"/>

        <!-- PASSCODE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PASSWORD"
            android:textColor="@color/brass"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:fontFamily="serif"
            android:layout_marginBottom="6dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/aadhar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:background="@null"
                android:textColor="@color/ivory"
                android:textColorHint="@color/text_moss"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"/>

            <CheckBox
                android:id="@+id/cbShowPassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:buttonTint="@android:color/white"/>
        </FrameLayout>

        <!-- CITY -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOCATION / CITY"
            android:textColor="@color/brass"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:fontFamily="serif"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/city"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your city"
            android:inputType="textPersonName"
            android:textColor="@color/ivory"
            android:textColorHint="@color/text_moss"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="20dp"/>

        <!-- COUNTRY -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COUNTRY"
            android:textColor="@color/brass"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:fontFamily="serif"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your country"
            android:inputType="textPersonName"
            android:textColor="@color/ivory"
            android:textColorHint="@color/text_moss"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="20dp"/>

        <!-- PINCODE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PINCODE"
            android:textColor="@color/brass"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:fontFamily="serif"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/pincode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your pincode"
            android:inputType="number"
            android:textColor="@color/ivory"
            android:textColorHint="@color/text_moss"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="20dp"/>

        <!-- PHONE NUMBER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHONE NUMBER"
            android:textColor="@color/brass"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:fontFamily="serif"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="36dp">

            <com.hbb20.CountryCodePicker
                android:id="@+id/countryCodePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ccp_defaultNameCode="PH"
                app:ccp_autoDetectCountry="true" />

            <EditText
                android:id="@+id/phonenumber"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="9123456789"
                android:inputType="phone"
                android:maxLength="10"
                android:background="@android:color/transparent"
                android:textColor="@color/ivory"
                android:textColorHint="@color/text_moss"
                android:textSize="14sp"
                android:fontFamily="serif"
                android:paddingHorizontal="8dp"/>
        </LinearLayout>

        <!-- SUBMIT -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/submit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="REGISTER"
            android:textColor="@color/forest_deep"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:background="@drawable/bg_button_brass"
            android:stateListAnimator="@null"
            android:layout_marginBottom="24dp"/>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© https://philhistoricsites.nhcp.gov.ph/"
            android:textColor="@color/text_moss"
            android:textSize="11sp"
            android:fontFamily="serif"
            android:gravity="center"/>

    </LinearLayout>

</ScrollView>