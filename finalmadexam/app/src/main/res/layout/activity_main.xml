<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forest_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:paddingTop="80dp"
        android:paddingBottom="48dp">

        <!-- Top label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NATIONAL HISTORICAL COMMISSION OF THE PHILIPPINES"
            android:textColor="@color/brass"
            android:gravity="center"
            android:textSize="9sp"
            android:letterSpacing="0.25"
            android:fontFamily="serif"
            android:layout_marginBottom="24dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cultural Heritage Sites"
            android:textColor="@color/ivory"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="of Cavite"
            android:textColor="@color/brass_light"
            android:textSize="24sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:layout_marginBottom="32dp"/>

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_brass"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  ◆  "
                android:textColor="@color/brass"
                android:textSize="12sp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_brass"/>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cavite — the cradle of Philippine independence — shelters some of the archipelago&#39;s most significant colonial and revolutionary landmarks."
            android:textColor="@color/ivory_dark"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.7"
            android:fontFamily="serif"
            android:gravity="center"
            android:layout_marginBottom="48dp"/>

        <!-- Register button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/register"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="REGISTER"
            android:textColor="@color/forest_deep"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:background="@drawable/bg_button_brass"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp"/>

        <!-- Login button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="LOGIN"
            android:textColor="@color/brass_light"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:background="@drawable/bg_button_outline"
            android:stateListAnimator="@null"
            android:layout_marginBottom="24dp"/>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© https://philhistoricsites.nhcp.gov.ph/"
            android:textColor="@color/text_moss"
            android:textSize="11sp"
            android:fontFamily="serif"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>